{
  "id": "reveal-scroll",
  "name": "滚动渐入",
  "category": "transition",
  "subcategory": "scroll",
  "description": "元素进入视口时从下方淡入上移",
  "css": ".fx-reveal{opacity:0;transform:translateY(40px);transition:opacity 0.7s ease-out,transform 0.7s cubic-bezier(0.22,1,0.36,1)}\n.fx-reveal.is-visible{opacity:1;transform:translateY(0)}",
  "js": "const observer=new IntersectionObserver((entries)=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');observer.unobserve(e.target)}})},{threshold:0.1});document.querySelectorAll('.fx-reveal').forEach(el=>observer.observe(el))",
  "tags": [
    "scroll",
    "reveal",
    "entrance",
    "animation"
  ],
  "keywords": [
    "滚动",
    "渐入",
    "显示"
  ],
  "dependencies": [],
  "source": "motionsites/crafted",
  "version": "1.0.0",
  "browserSupport": "Chrome 90+, Firefox 90+, Safari 15+",
  "html": ""
}